# ============================================================
# Hybrid AI Coding Agent - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Google Gemini API ────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── NVIDIA NIM API (Model B) ─────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Ollama Local Model ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_NUM_GPU_LAYERS=28

# ── Application ──────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# ── Cost Management ──────────────────────────────────────────
MAX_GEMINI_TOKENS_PER_REQUEST=8192
MAX_GROK_TOKENS_PER_REQUEST=8192
REQUEST_TIMEOUT_SECONDS=120
MAX_ESCALATION_RETRIES=3
AUTO_ESCALATION_ENABLED=true

# ── Routing ──────────────────────────────────────────────────
# Options: AUTO | GEMINI | GROK | LOCAL | GEMINI+LOCAL | GROK+LOCAL | ALL
DEFAULT_MODEL_MODE=AUTO

# ── Timeouts / retries actually read by the backend ──────────
# (REQUEST_TIMEOUT_SECONDS / MAX_ESCALATION_RETRIES above are NOT used by the code)
GEMINI_TIMEOUT=180
GEMINI_MAX_RETRIES=1
NVIDIA_TIMEOUT=90
NVIDIA_MAX_RETRIES=2
OLLAMA_TIMEOUT=180
ESCALATION_MAX_RETRIES=1
